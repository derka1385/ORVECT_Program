DEMO_TECHNICIAN_EMAIL=technician@example.com
DEMO_TECHNICIAN_PASSWORD=demo-tech-change-me
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
VIN_PROVIDER=mock
NHTSA_VPIC_ENABLED=false
VIN_PROVIDER_TIMEOUT_SECONDS=10
VIN_CACHE_TTL_DAYS=30
VIN_RETENTION_DAYS=365
VIN_RATE_LIMIT_PER_MINUTE=30
AUTOREF_API_KEY=
AUTOREF_API_URL=https://api-gateway.autoref.eu
AUTOREF_TIMEOUT_SECONDS=15
AUTOREF_MAX_CANDIDATES=3
REGISTRATION_PROVIDER=mock
REGISTRATION_API_URL=
REGISTRATION_API_KEY=
REGISTRATION_API_TIMEOUT_SECONDS=12
VEHICLE_PROVIDER_PRIMARY=mock
VEHICLE_PROVIDER_FALLBACKS=
AAA_DATA_API_URL=
AAA_DATA_API_KEY=
TECALLIANCE_API_URL=
TECALLIANCE_API_KEY=
AUTO_WAYS_API_URL=
AUTO_WAYS_API_KEY=
VEHICLE_LOOKUP_TIMEOUT_MS=8000
VEHICLE_LOOKUP_CACHE_TTL_SECONDS=86400
VEHICLE_LOOKUP_ENABLE_MOCK=false
VEHICLE_CONFIDENCE_RELIABLE=0.90
VEHICLE_CONFIDENCE_RECOMMENDED=0.70
VEHICLE_CONFIDENCE_AMBIGUOUS=0.40
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_REASONING=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_RATE_LIMIT_PER_MINUTE=10
DIAGNOSTIC_IMAGE_DIR=/app/private_images
DIAGNOSTIC_IMAGE_RETENTION_DAYS=90
MAX_DIAGNOSTIC_IMAGES=8
MAX_IMAGE_BYTES=8000000
MAX_IMAGE_TOTAL_BYTES=24000000
MAX_IMAGE_DIMENSION=2400
MAX_IMAGE_PIXELS=16000000
MAX_DIAGNOSTIC_FAULT_CODES=30
MAX_DIAGNOSTIC_MEASUREMENTS=100
MAX_DIAGNOSTIC_OBSERVATIONS=200
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
KEEP_ORIGINAL_IMAGES=false

# Gemini exploratory mode: provisional DTC meanings and unverified hypotheses.
DIAGNOSTIC_EXPLORATION_ENABLED=false
AUTH_PROVIDER=legacy
# Set AUTH_PROVIDER=firebase only when the Firebase project and credentials are configured.
FIREBASE_PROJECT_ID=
FIREBASE_SELF_SIGNUP_ENABLED=false
FIREBASE_CHECK_REVOKED=true
# Server-only path to a secret service-account JSON file (never commit the file).
GOOGLE_APPLICATION_CREDENTIALS=
